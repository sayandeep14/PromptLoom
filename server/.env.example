# PromptLoom registry — copy to .env and fill in real values.
# NEVER commit .env to source control.

# PostgreSQL connection URL (required)
# postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# HTTP port (default 8080)
PORT=8080

# Secret required to publish or delete packs (header: X-Upload-Secret).
# If unset, the registry is READ-ONLY: POST and DELETE return 503.
# Must be at least 16 characters. Generate one with: openssl rand -hex 32
UPLOAD_SECRET=

# Browser origins allowed to call the API, comma-separated.
# Default (empty): no CORS headers — the CLI does not need them.
# Use * only for a fully public read-only registry.
CORS_ORIGINS=

# Set to 1 when running behind a reverse proxy (nginx, Caddy, a cloud LB) so
# rate limiting uses X-Forwarded-For. Leave unset when clients connect directly,
# otherwise callers can spoof their IP.
TRUST_PROXY=

# Limits (defaults shown)
MAX_BODY_BYTES=8388608          # 8 MiB per request
RATE_LIMIT_READ_PER_MIN=120     # per IP
RATE_LIMIT_WRITE_PER_MIN=10     # per IP; failed auth attempts count too
