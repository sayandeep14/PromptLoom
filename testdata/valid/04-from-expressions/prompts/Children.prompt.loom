prompt Picked inherits Alpha, Beta {
  persona :=
    from(Beta)

  instructions :=
    from(parent[0]) and parent[1].instructions[1..3]
}

prompt Indexed inherits Alpha, Beta {
  persona :=
    from(parent[1])

  instructions :=
    parent[0].instructions[2] and parent[1].instructions[0] and parent[1].instructions[3]
}

prompt Explicit inherits Alpha, Beta {
  instructions :=
    from(parent[1]) and from(parent[0])
}
